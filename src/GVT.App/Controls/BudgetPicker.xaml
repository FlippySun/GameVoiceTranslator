<UserControl x:Class="GVT.App.Controls.BudgetPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 单次花费上限：常用档位 + 自定义金额。侧边栏弹出面板和诊断页共用。 -->
    <StackPanel>
        <Border Style="{StaticResource SegmentHost}">
            <StackPanel x:Name="Presets" Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" Content="¥2" Tag="2" Click="Preset_Click"/>
                <RadioButton Style="{StaticResource Segment}" Content="¥5" Tag="5" Click="Preset_Click"/>
                <RadioButton Style="{StaticResource Segment}" Content="¥10" Tag="10" Click="Preset_Click"/>
                <RadioButton Style="{StaticResource Segment}" Content="¥20" Tag="20" Click="Preset_Click"/>
                <RadioButton Style="{StaticResource Segment}" Content="不限" Tag="0" Click="Preset_Click"/>
            </StackPanel>
        </Border>
        <DockPanel Margin="0,10,0,0" LastChildFill="False">
            <TextBlock Text="自定义" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="2,0,10,0"/>
            <TextBlock Text="¥" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="CustomBox" Width="86" VerticalAlignment="Center" KeyDown="CustomBox_KeyDown"/>
            <Button Style="{StaticResource BtnBase}" Content="应用" Padding="12,6" Margin="8,0,0,0" Click="Apply_Click"/>
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource B.Danger}" FontSize="12" Margin="2,6,0,0" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
