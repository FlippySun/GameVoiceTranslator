<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 只用 WinForms 的托盘图标 NotifyIcon；不引入它的全局 using，避免和 WPF 类型重名 -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>GameVoiceTranslator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 显示在文件属性、任务管理器、任务栏分组里的名称 -->
    <Product>游戏双译</Product>
    <AssemblyTitle>游戏双译</AssemblyTitle>
    <Description>游戏内双向语音翻译：你说中文队友听英文，队友说英文你听中文</Description>
    <Company>游戏双译</Company>
    <Copyright>© 2026</Copyright>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 只保留中文资源，安装包更小 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GVT.Core\GVT.Core.csproj" />
    <ProjectReference Include="..\GVT.Watchdog\GVT.Watchdog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <None Include="glossary.default.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 可选：自己编译时把 VB-Audio 安装包放在 installer/drivers（不入库、不随公开版本分发），“安装环境”会优先用本地的，否则从官网下载 -->
    <None Include="..\..\installer\drivers\**\*" Link="drivers\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models\silero_vad.onnx" Link="models\silero_vad.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\models\silero_vad.onnx')" />
  </ItemGroup>

</Project>
