<Window x:Class="GVT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏双向语音翻译 · 验证版" Width="980" Height="760" MinWidth="820" MinHeight="600"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="1. 阿里云百炼 API Key">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="SaveKeyButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="SaveKey_Click">保存</Button>
                            <PasswordBox x:Name="ApiKeyBox" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="KeyStatus" Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2. 设备">
                    <StackPanel>
                        <TextBlock Text="我的麦克风（真实麦克风）"/>
                        <ComboBox x:Name="MicCombo"/>
                        <TextBlock Text="英文译音发送到（游戏里把它的另一端选为麦克风）" Margin="0,6,0,0"/>
                        <ComboBox x:Name="SendOutCombo"/>
                        <TextBlock Text="队友声音来源（游戏“语音聊天输出设备”指向的虚拟线）" Margin="0,6,0,0"/>
                        <ComboBox x:Name="SourceCombo"/>
                        <TextBlock Text="我的耳机" Margin="0,6,0,0"/>
                        <ComboBox x:Name="HeadphoneCombo"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Click="RefreshDevices_Click">刷新设备</Button>
                            <Button Click="OpenConfig_Click">打开配置文件夹</Button>
                        </StackPanel>
                        <TextBlock x:Name="SetupHint" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="DarkGoldenrod"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="3. 模式">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="说话方式" VerticalAlignment="Center"/>
                        <ComboBox x:Name="GateCombo" Grid.Column="1">
                            <ComboBoxItem Content="按住说话（推荐）" Tag="PushToTalk"/>
                            <ComboBoxItem Content="语音激活（开放麦）" Tag="VoiceActivity"/>
                        </ComboBox>
                        <TextBlock Text="接收听法" Grid.Row="1" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ListenCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="ListenCombo_Changed">
                            <ComboBoxItem Content="译音优先（原声压低）" Tag="TranslationFirst"/>
                            <ComboBoxItem Content="原声 + 译音" Tag="Both"/>
                        </ComboBox>
                        <TextBlock Text="翻译引擎" Grid.Row="2" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TranslatorCombo" Grid.Row="2" Grid.Column="1">
                            <ComboBoxItem Content="qwen-mt-flash（专用翻译 + 术语）" Tag="Mt"/>
                            <ComboBoxItem Content="qwen-flash（通用模型 + 规则）" Tag="Llm"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="StartButton" Click="Start_Click" FontWeight="Bold" Padding="20,6">开始翻译</Button>
                    <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False" Padding="20,6">停止</Button>
                </StackPanel>

                <GroupBox Header="快捷键（游戏中可用）">
                    <TextBlock x:Name="HotkeyHelp" TextWrapping="Wrap" LineHeight="20"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <GroupBox Header="状态" Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="我说给队友听（中 → 英）"/>
                        <TextBlock x:Name="SendState" Margin="0,2"/>
                        <ProgressBar x:Name="MicLevel" Height="8" Minimum="-60" Maximum="0"/>
                        <CheckBox x:Name="SendEnabledCheck" Content="启用发送" Margin="0,4,0,0" Click="SendEnabled_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontWeight="Bold" Text="队友说给我听（英 → 中）"/>
                        <TextBlock x:Name="ReceiveState" Margin="0,2"/>
                        <ProgressBar x:Name="SourceLevel" Height="8" Minimum="-60" Maximum="0"/>
                        <CheckBox x:Name="ReceiveEnabledCheck" Content="启用中文播报" Margin="0,4,0,0" Click="ReceiveEnabled_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="UsageText" Grid.ColumnSpan="3" Margin="0,70,0,0" Foreground="Gray" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WarningText" Grid.ColumnSpan="3" Margin="0,92,0,0" Foreground="Firebrick" TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="字幕" Grid.Row="1">
                <ListBox x:Name="SubtitleList" BorderThickness="0"/>
            </GroupBox>

            <GroupBox Header="延迟（句末 → 各阶段，毫秒）与日志" Grid.Row="2" Margin="0">
                <ListBox x:Name="LogList" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
