                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ========== 设备与接入 ========== -->
                <ScrollViewer x:Name="PageSetup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <TextBlock Text="设备与接入" Style="{StaticResource T.H1}" Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel>
                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Border x:Name="KeyChip" Style="{StaticResource Chip}">
                                            <TextBlock x:Name="KeyChipText" Text="未设置" FontSize="12"/>
                                        </Border>
                                        <Button x:Name="CreateKeyBtn" Style="{StaticResource BtnPrimary}" Padding="12,5" Visibility="Collapsed" Click="CreateKey_Click"
                                                ToolTip="打开阿里云百炼控制台的 API Key 页面">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="去创建 API Key"/>
                                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource F.Icon}" FontSize="11" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="阿里云百炼 API Key" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpTip}" ToolTip="请使用“按量付费”的 Key（sk-ws- 开头）。Token Plan / Coding Plan 的 sk-sp- Key 不能用。&#x0a;Key 用 Windows 当前用户加密保存在本机，不会明文写入磁盘。"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,14,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="保存" Margin="10,0,0,0" Click="SaveKey_Click"/>
                                    <PasswordBox x:Name="ApiKeyBox"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DeviceCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel>
                                    <Grid DockPanel.Dock="Right">
                                        <Button x:Name="RefreshDevicesBtn" Style="{StaticResource BtnBase}" Click="RefreshDevices_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource F.Icon}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="重新检测" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="InstallEnvBtn" Style="{StaticResource BtnPrimary}" Click="InstallEnv_Click" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="InstallEnvIcon" Text="&#xE896;" FontFamily="{StaticResource F.Icon}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="InstallEnvText" Text="安装环境" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="音频设备" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <WrapPanel Margin="0,10,0,16">
                                    <Border x:Name="CableAChip" Style="{StaticResource Chip}" Margin="0,0,8,0"><TextBlock x:Name="CableAText" FontSize="12"/></Border>
                                    <Border x:Name="CableBChip" Style="{StaticResource Chip}"><TextBlock x:Name="CableBText" FontSize="12"/></Border>
                                </WrapPanel>
                                <Border x:Name="EnvMissingBox" Style="{StaticResource Inset}" Margin="0,-4,0,16" Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource F.Icon}" FontSize="16" Foreground="{StaticResource B.Warn}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                        <TextBlock x:Name="EnvMissingText" Foreground="{StaticResource B.Text}" TextWrapping="Wrap" LineHeight="20"/>
                                    </DockPanel>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="我的麦克风" Style="{StaticResource FieldLabel}" Foreground="{StaticResource B.Me}"/>
                                        <ComboBox x:Name="MicCombo"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="英文译音发送到" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Me}" VerticalAlignment="Center"/>
                                            <ContentControl Style="{StaticResource HelpTipSmall}" ToolTip="选 CABLE Input。游戏 / 语音软件的麦克风要选它的另一端 CABLE Output。"/>
                                        </StackPanel>
                                        <ComboBox x:Name="SendOutCombo"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="队友声音来源" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Mate}" VerticalAlignment="Center"/>
                                            <ContentControl Style="{StaticResource HelpTipSmall}" ToolTip="选 Hi-Fi Cable Output。游戏的“语音聊天输出设备”要选它的另一端 Hi-Fi Cable Input。"/>
                                        </StackPanel>
                                        <ComboBox x:Name="SourceCombo"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="我的耳机" Style="{StaticResource FieldLabel}" Foreground="{StaticResource B.Mate}"/>
                                        <ComboBox x:Name="HeadphoneCombo"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="GuideCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="在游戏 / 语音软件里这样设置" Style="{StaticResource T.H2}"/>
                                <Border Style="{StaticResource SegmentHost}" Margin="0,12,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Guide" Content="MW4" IsChecked="True" Tag="MW4" Checked="Guide_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Guide" Content="KOOK" Tag="KOOK" Checked="Guide_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Guide" Content="Discord" Tag="Discord" Checked="Guide_Checked"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="GuideList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="260"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Item1}" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Item2}" Foreground="{StaticResource B.Text}" FontWeight="Medium" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border x:Name="TransCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="翻译方式" Style="{StaticResource T.H2}"/>
                                <TextBlock Text="说话方式" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="GatePtt" Style="{StaticResource Segment}" GroupName="Gate" Content="按住说话（推荐）"/>
                                        <RadioButton x:Name="GateVad" Style="{StaticResource Segment}" GroupName="Gate" Content="语音激活"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                    <TextBlock Text="翻译引擎" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                                    <ContentControl Style="{StaticResource HelpTipSmall}" ToolTip="快：qwen-flash。&#x0a;更准：qwen3.8-flash，更善于察觉听错的句子（标成“可能是”或不播报），每句多等约 0.35 秒。&#x0a;机器翻译：qwen-mt-flash 专用翻译模型。&#x0a;说话方式和翻译引擎在下次点“开始”时生效。"/>
                                </StackPanel>
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TrLlm" Style="{StaticResource Segment}" GroupName="Tr" Content="快（推荐）"/>
                                        <RadioButton x:Name="TrLlmPlus" Style="{StaticResource Segment}" GroupName="Tr" Content="更准"/>
                                        <RadioButton x:Name="TrMt" Style="{StaticResource Segment}" GroupName="Tr" Content="机器翻译"/>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="识别队友的话" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Mate}" VerticalAlignment="Center"/>
                                            <ContentControl Style="{StaticResource HelpTipSmall}" ToolTip="Qwen3-ASR：对口音和游戏语音压缩更准，队友里有人说中文时会自动认出来（只显示不播报）。&#x0a;Fun-ASR：之前一直用的识别。&#x0a;在下次点“开始”时生效。"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource SegmentHost}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RecvAsrQwen3" Style="{StaticResource Segment}" GroupName="RecvAsr" Content="Qwen3-ASR（推荐）"/>
                                                <RadioButton x:Name="RecvAsrFun" Style="{StaticResource Segment}" GroupName="RecvAsr" Content="Fun-ASR"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="识别我的中文" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Me}" VerticalAlignment="Center"/>
                                            <ContentControl Style="{StaticResource HelpTipSmall}" ToolTip="Fun-ASR：配合游戏热词，中文最稳。&#x0a;Qwen3-ASR：更少口头停顿，但偶尔会把意思听反（例如“我不知道”听成“我知道”）。&#x0a;在下次点“开始”时生效。"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource SegmentHost}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="SendAsrFun" Style="{StaticResource Segment}" GroupName="SendAsr" Content="Fun-ASR（推荐）"/>
                                                <RadioButton x:Name="SendAsrQwen3" Style="{StaticResource Segment}" GroupName="SendAsr" Content="Qwen3-ASR"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 声音 ========== -->
                <ScrollViewer x:Name="PageVoice" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="940" HorizontalAlignment="Left" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock Text="声音" Style="{StaticResource T.H1}" VerticalAlignment="Center"/>
                            <ContentControl  Style="{StaticResource HelpTip}" Margin="10,3,0,0" ToolTip="点 ▶ 在自己耳机里试听。修改从下一句开始生效，不会打断正在播的内容。"/>
                        </StackPanel>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource B.MeSoft}">
                                        <TextBlock Text="&#xE720;" FontFamily="{StaticResource F.Icon}" FontSize="13" Foreground="{StaticResource B.Me}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="队友听到的英文声音" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpTip}" ToolTip="建议先试 Qwen3 的 Ryan、Aiden 和“设计”的声音。&#x0a;Qwen3 音色不受下面的说话风格和语速影响。"/>
                                    </StackPanel>
                                </StackPanel>
                                <ListBox x:Name="SendVoiceList" Style="{StaticResource VoiceList}" Tag="{StaticResource B.Me}" Margin="0,16,0,8" SelectionChanged="Voice_Changed"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="说话风格" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource SegmentHost}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="SendStyleCasual" Style="{StaticResource Segment}" GroupName="SendStyle" Content="开黑口语" Checked="Voice_Changed"/>
                                                <RadioButton x:Name="SendStyleCallout" Style="{StaticResource Segment}" GroupName="SendStyle" Content="冷静报点" Checked="Voice_Changed"/>
                                                <RadioButton x:Name="SendStyleStandard" Style="{StaticResource Segment}" GroupName="SendStyle" Content="标准" Checked="Voice_Changed"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <DockPanel>
                                            <TextBlock x:Name="SendRateText" DockPanel.Dock="Right" Text="1.05×" Style="{StaticResource T.Caption}"/>
                                            <TextBlock Text="语速" Style="{StaticResource FieldLabel}"/>
                                        </DockPanel>
                                        <Slider x:Name="SendRate" Minimum="0.8" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" ValueChanged="Rate_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                    <TextBlock Text="自定义风格" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                                    <ContentControl Style="{StaticResource HelpTipSmall}" ToolTip="可选。用英文描述想要的语气，例如 Speak like a calm squad leader。填了会覆盖上面选的说话风格。"/>
                                </StackPanel>
                                <TextBox x:Name="SendInstruction" LostFocus="Instruction_LostFocus"/>
                                <Border Style="{StaticResource Inset}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="用一句话设计新的英文声音" Foreground="{StaticResource B.Text}" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <ContentControl Style="{StaticResource HelpTipSmall}" ToolTip="描述性别、年龄、口音、语速、情绪和说话场景，例如“二十出头的美国男生，嗓音略沙哑，说话随意、语速偏快，像和朋友开黑”。&#x0a;生成约需 10 秒，会自动试听并加入上面的列表。"/>
                                        </StackPanel>
                                        <DockPanel>
                                            <Button x:Name="DesignBtn" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="生成新音色" Margin="10,0,0,0" Click="DesignVoice_Click"/>
                                            <TextBox x:Name="DesignPrompt"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource B.MateSoft}">
                                        <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource F.Icon}" FontSize="13" Foreground="{StaticResource B.Mate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="我听到的中文声音" Style="{StaticResource T.H2}"/>
                                </StackPanel>
                                <ListBox x:Name="RecvVoiceList" Style="{StaticResource VoiceList}" Tag="{StaticResource B.Mate}" Margin="0,16,0,8" SelectionChanged="Voice_Changed"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="说话风格" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource SegmentHost}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RecvStyleCasual" Style="{StaticResource Segment}" GroupName="RecvStyle" Content="开黑口语" Checked="Voice_Changed"/>
                                                <RadioButton x:Name="RecvStyleCallout" Style="{StaticResource Segment}" GroupName="RecvStyle" Content="冷静报点" Checked="Voice_Changed"/>
                                                <RadioButton x:Name="RecvStyleStandard" Style="{StaticResource Segment}" GroupName="RecvStyle" Content="标准" Checked="Voice_Changed"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <DockPanel>
                                            <TextBlock x:Name="RecvRateText" DockPanel.Dock="Right" Text="1.15×" Style="{StaticResource T.Caption}"/>
                                            <TextBlock Text="语速" Style="{StaticResource FieldLabel}"/>
                                        </DockPanel>
                                        <Slider x:Name="RecvRate" Minimum="0.8" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" ValueChanged="Rate_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 浮窗与快捷键 ========== -->
                <ScrollViewer x:Name="PageOverlay" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <TextBlock Text="浮窗与快捷键" Style="{StaticResource T.H1}" Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="OverlayVisible" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="OverlayVisible_Click"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="游戏内浮窗" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpTip}" ToolTip="浮窗鼠标穿透、不抢焦点，游戏请用“无边框全屏”。&#x0a;编辑时可以拖动、拖右下角改大小，旁边的工具栏可调背景、字号和文字颜色。&#x0a;浮窗拉得越高，显示的句子越多，最新的在最下面。"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Inset}" Margin="0,14,0,16">
                                    <DockPanel>
                                        <Button x:Name="OverlayEditBtn" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Click="OverlayEdit_Click" Content="调整位置和大小"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="OverlayEditHint" Text="" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <DockPanel><TextBlock x:Name="OvFontText" DockPanel.Dock="Right" Style="{StaticResource T.Caption}"/><TextBlock Text="字号" Style="{StaticResource FieldLabel}"/></DockPanel>
                                        <Slider x:Name="OvFont" Minimum="12" Maximum="34" SmallChange="1" ValueChanged="Overlay_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <DockPanel><TextBlock x:Name="OvOpacityText" DockPanel.Dock="Right" Style="{StaticResource T.Caption}"/><TextBlock Text="背景不透明度" Style="{StaticResource FieldLabel}"/></DockPanel>
                                        <Slider x:Name="OvOpacity" Minimum="0.2" Maximum="1" SmallChange="0.05" ValueChanged="Overlay_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <DockPanel><TextBlock x:Name="OvHoldText" DockPanel.Dock="Right" Style="{StaticResource T.Caption}"/><TextBlock Text="字幕停留多久后淡出" Style="{StaticResource FieldLabel}" ToolTip="拖到最右边 = 一直保留"/></DockPanel>
                                        <Slider x:Name="OvHold" Minimum="5" Maximum="125" SmallChange="5" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="Overlay_Changed"/>
                                    </StackPanel>
                                    <CheckBox x:Name="OvShowOriginal" Grid.Row="2" Grid.Column="2" Style="{StaticResource Toggle}" VerticalAlignment="Bottom" Margin="0,0,0,2" Click="Overlay_Changed">
                                        <TextBlock Text="译文下方显示原文" Foreground="{StaticResource B.Text}"/>
                                    </CheckBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="恢复默认" Click="ResetHotkeys_Click"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="快捷键" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpTip}" ToolTip="点右侧按键，再按下新的键（支持鼠标侧键）。游戏在前台时同样有效。"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Height="6"/>
                                <ItemsControl x:Name="HotkeyList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnBase}" MinWidth="120" Click="RebindHotkey_Click" Tag="{Binding}">
                                                        <TextBlock Text="{Binding Display}" FontFamily="{StaticResource F.Mono}" FontSize="12.5"/>
                                                    </Button>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource B.Text}" FontWeight="Medium" VerticalAlignment="Center"/>
                                                        <ContentControl Style="{StaticResource HelpTipSmall}" ToolTip="{Binding Description}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 诊断 ========== -->
                <Grid x:Name="PageDiag" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnBase}" Click="OpenLogs_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource F.Icon}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="打开日志文件夹" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="诊断与日志" Style="{StaticResource T.H1}" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource HelpTip}" Margin="10,3,0,0" ToolTip="下面列出每句话从说完到识别、翻译、开始播放各用了多少毫秒，以及运行日志。"/>
                            </StackPanel>
                            <CheckBox x:Name="SaveAudioCheck" Style="{StaticResource Toggle}" Margin="0,16,0,0" Click="SaveAudio_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="保存识别音频" Foreground="{StaticResource B.Text}" VerticalAlignment="Center"/>
                                    <ContentControl Style="{StaticResource HelpTipSmall}" ToolTip="把每句话的录音和识别结果存到日志文件夹的 utterances 里，用于改进识别。只保存在本机，下次点“开始”生效。"/>
                                </StackPanel>
                            </CheckBox>
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0" HorizontalAlignment="Left">
                                <WrapPanel>
                                    <StackPanel Margin="0,0,40,4">
                                        <TextBlock Text="单次花费上限" Style="{StaticResource FieldLabel}"/>
                                        <c:BudgetPicker x:Name="DiagBudget"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="点右上角关闭时" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource SegmentHost}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="CloseAsk" Style="{StaticResource Segment}" GroupName="CloseAct" Content="每次询问" Click="CloseAction_Click"/>
                                                <RadioButton x:Name="CloseTray" Style="{StaticResource Segment}" GroupName="CloseAct" Content="最小化到托盘" Click="CloseAction_Click"/>
                                                <RadioButton x:Name="CloseExit" Style="{StaticResource Segment}" GroupName="CloseAct" Content="彻底退出" Click="CloseAction_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12,6,8">
                        <Grid>
                        <TextBlock x:Name="LogEmpty" Text="暂无日志" Style="{StaticResource T.Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{StaticResource B.Text2}"
                                                   TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 提示条 -->
        <Border x:Name="ToastBox" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Background="{StaticResource B.Surface3}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1"
                CornerRadius="12" Padding="16,10" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="ToastSlide" Y="12"/></Border.RenderTransform>
            <TextBlock x:Name="ToastText" Foreground="{StaticResource B.Text}"/>
        </Border>
        <!-- 问题提示卡：开始前检查不通过、安装环境的结果等。不会自动消失，修好或点关闭才收起 -->
        <Border x:Name="NoticeBox" Grid.Column="1" Style="{StaticResource FloatCard}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,26" Width="560" Padding="0" Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="NoticeSlide"/></Border.RenderTransform>
            <StackPanel>
                <DockPanel Margin="18,16,10,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Padding="8,4" VerticalAlignment="Top" Click="NoticeClose_Click" ToolTip="关闭">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource F.Icon}" FontSize="11"/>
                    </Button>
                    <Border x:Name="NoticeIconBox" DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{StaticResource B.DangerSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock x:Name="NoticeIcon" Text="&#xE7BA;" FontFamily="{StaticResource F.Icon}" FontSize="16" Foreground="{StaticResource B.Danger}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NoticeTitle" Text="还不能开始翻译" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                        <TextBlock x:Name="NoticeSub" Style="{StaticResource T.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <ItemsControl x:Name="NoticeList" Margin="10,0,10,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnBase}" Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Content="{Binding ActionText}" Tag="{Binding}" Click="NoticeAction_Click"
                                            Visibility="{Binding ActionVisibility}"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource F.Icon}" FontSize="14" Foreground="{Binding GlyphBrush}"
                                               VerticalAlignment="Top" Margin="0,2,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource B.Text}" FontWeight="Medium" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="18"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 关闭方式对话框 -->
        <Grid x:Name="CloseDialog" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#99000000">
            <Border x:Name="CloseCard" Style="{StaticResource FloatCard}" Width="440" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.RenderTransform><ScaleTransform x:Name="CloseScale" CenterX="220" CenterY="140"/></Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="要关闭游戏双译吗？" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" FontFamily="{StaticResource F.Display}" Margin="0,0,0,16"/>
                    <RadioButton x:Name="ChoiceTray" Style="{StaticResource ChoiceCard}" GroupName="CloseChoice" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="最小化到托盘（推荐）" FontWeight="Medium" Foreground="{StaticResource B.Text}"/>
                            <TextBlock Text="翻译和快捷键照常工作，双击托盘图标重新打开" Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ChoiceExit" Style="{StaticResource ChoiceCard}" GroupName="CloseChoice">
                        <TextBlock Text="彻底退出" FontWeight="Medium" Foreground="{StaticResource B.Text}"/>
                    </RadioButton>
                    <CheckBox x:Name="ChoiceRemember" Style="{StaticResource Toggle}" Margin="2,8,0,0">
                        <TextBlock Text="不再询问" Foreground="{StaticResource B.Text2}" FontSize="12.5" ToolTip="以后可以在“诊断与日志”里修改"/>
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource BtnGhost}" Content="取消" Click="CloseCancel_Click" IsCancel="True"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="确定" Margin="8,0,0,0" Padding="22,7" Click="CloseConfirm_Click" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
