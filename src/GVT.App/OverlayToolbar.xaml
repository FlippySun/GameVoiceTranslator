<Window x:Class="GVT.App.OverlayToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏双译 · 浮窗样式" Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource F.Ui}" FontSize="12.5" Foreground="{StaticResource B.Text}" UseLayoutRounding="True">
    <Border Background="#F2151820" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="6">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45"/></Border.Effect>
        <StackPanel Width="520">
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Padding="12,5" Click="Done_Click">
                    <TextBlock x:Name="DoneText" Text="完成并锁定"/>
                </Button>
                <TextBlock Text="浮窗样式" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="  拖动浮窗移动 · 右下角改大小" Style="{StaticResource T.Caption}" VerticalAlignment="Center"/>
            </DockPanel>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Style="{StaticResource T.Caption}"/>
                        <TextBlock Text="背景不透明度" Style="{StaticResource T.Label}"/>
                    </DockPanel>
                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <DockPanel>
                        <TextBlock x:Name="FontText" DockPanel.Dock="Right" Style="{StaticResource T.Caption}"/>
                        <TextBlock Text="字号（也可以在浮窗上滚动滚轮）" Style="{StaticResource T.Label}"/>
                    </DockPanel>
                    <Slider x:Name="FontSlider" Minimum="12" Maximum="40" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Changed"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="3" Height="12" CornerRadius="1.5" Background="{StaticResource B.MeGradient}" Margin="0,0,7,0"/>
                    <TextBlock Text="我说的" Foreground="{StaticResource B.Text2}"/>
                </StackPanel>
                <WrapPanel x:Name="MeSwatches" Grid.Column="1" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="3" Height="12" CornerRadius="1.5" Background="{StaticResource B.MateGradient}" Margin="0,0,7,0"/>
                    <TextBlock Text="队友说的" Foreground="{StaticResource B.Text2}"/>
                </StackPanel>
                <WrapPanel x:Name="MateSwatches" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="3" Height="12" CornerRadius="1.5" Background="{StaticResource B.Text3}" Margin="0,0,7,0"/>
                    <TextBlock Text="原文小字" Foreground="{StaticResource B.Text2}"/>
                </StackPanel>
                <WrapPanel x:Name="OrigSwatches" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>

            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Padding="8,4" Content="恢复默认样式" Click="Reset_Click"/>
                <CheckBox x:Name="ShowOriginalCheck" Style="{StaticResource Toggle}" Click="Changed">
                    <TextBlock Text="显示原文小字" Foreground="{StaticResource B.Text}"/>
                </CheckBox>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
